+struct WaylandTabletToolFrame
+{
+    enum class Proximity {
+        Unchanged,
+        In,
+        Out,
+    };
+    Proximity proximity = Proximity::Unchanged;
+    bool down = false;
+    bool up = false;
+    bool axesChanged = false;
+    std::vector<std::pair<quint32, bool>> buttons;
+};
+
+struct WaylandTabletToolActions
+{
+    bool proximityIn = false;
+    bool tipDown = false;
+    bool tipUp = false;
+    bool axis = false;
+    std::vector<std::pair<quint32, bool>> buttons;
+    bool proximityOut = false;
+};
+
+static WaylandTabletToolActions planTabletToolFrame(const WaylandTabletToolFrame &frame, bool inProximity, bool tipDown, const QList<quint32> &pressedButtons)
+{
+    WaylandTabletToolActions actions;
+    if (frame.proximity == WaylandTabletToolFrame::Proximity::In && !inProximity) {
+        actions.proximityIn = true;
+        inProximity = true;
+    }
+    if (!inProximity) {
+        return actions;
+    }
+
+    if (frame.down && !tipDown) {
+        actions.tipDown = true;
+        tipDown = true;
+    }
+    if (frame.up && tipDown) {
+        actions.tipUp = true;
+        tipDown = false;
+    }
+    actions.axis = frame.axesChanged && !actions.proximityIn && !actions.tipDown && !actions.tipUp;
+
+    QList<quint32> pressed = pressedButtons;
+    for (const auto &[button, isPressed] : frame.buttons) {
+        if (isPressed == pressed.contains(button)) {
+            continue;
+        }
+        if (isPressed) {
+            pressed.append(button);
+        } else {
+            pressed.removeOne(button);
+        }
+        actions.buttons.emplace_back(button, isPressed);
+    }
+
+    if (frame.proximity == WaylandTabletToolFrame::Proximity::Out) {
+        if (tipDown) {
+            actions.tipUp = true;
+        }
+        for (quint32 button : std::as_const(pressed)) {
+            actions.buttons.emplace_back(button, false);
+        }
+        actions.proximityOut = true;
+    }
+    return actions;
+}
+
+static QPointF tabletTiltToOutput(OutputTransform transform, const QPointF &tilt)
+{
+    // QSizeF() is (-1, -1), and would add an offset to a direction.
+    return transform.inverted().map(tilt, QSizeF(0, 0));
+}
+
+static qreal tabletRotationToOutput(OutputTransform transform, qreal degrees)
+{
+    const qreal radians = qDegreesToRadians(degrees);
+    const QPointF direction = tabletTiltToOutput(transform, QPointF(std::sin(radians), -std::cos(radians)));
+    return std::fmod(qRadiansToDegrees(std::atan2(direction.x(), -direction.y())) + 360, 360);
+}
+
+static InputDeviceTabletTool::Type toolType(uint32_t type)
+{
+    switch (type) {
+    case ZWP_TABLET_TOOL_V2_TYPE_ERASER:
+        return InputDeviceTabletTool::Eraser;
+    case ZWP_TABLET_TOOL_V2_TYPE_BRUSH:
+        return InputDeviceTabletTool::Brush;
+    case ZWP_TABLET_TOOL_V2_TYPE_PENCIL:
+        return InputDeviceTabletTool::Pencil;
+    case ZWP_TABLET_TOOL_V2_TYPE_AIRBRUSH:
+        return InputDeviceTabletTool::Airbrush;
+    case ZWP_TABLET_TOOL_V2_TYPE_FINGER:
+        return InputDeviceTabletTool::Finger;
+    case ZWP_TABLET_TOOL_V2_TYPE_MOUSE:
+        return InputDeviceTabletTool::Mouse;
+    case ZWP_TABLET_TOOL_V2_TYPE_LENS:
+        return InputDeviceTabletTool::Lens;
+    default:
+        return InputDeviceTabletTool::Pen;
+    }
+}
+
+static std::optional<InputDeviceTabletTool::Capability> toolCapability(uint32_t capability)
+{
+    switch (capability) {
+    case ZWP_TABLET_TOOL_V2_CAPABILITY_TILT:
+        return InputDeviceTabletTool::Tilt;
+    case ZWP_TABLET_TOOL_V2_CAPABILITY_PRESSURE:
+        return InputDeviceTabletTool::Pressure;
+    case ZWP_TABLET_TOOL_V2_CAPABILITY_DISTANCE:
+        return InputDeviceTabletTool::Distance;
+    case ZWP_TABLET_TOOL_V2_CAPABILITY_ROTATION:
+        return InputDeviceTabletTool::Rotation;
+    case ZWP_TABLET_TOOL_V2_CAPABILITY_SLIDER:
+        return InputDeviceTabletTool::Slider;
+    case ZWP_TABLET_TOOL_V2_CAPABILITY_WHEEL:
+        return InputDeviceTabletTool::Wheel;
+    default:
+        return std::nullopt;
+    }
+}
