+struct WaylandTabletSeat::Tool
+{
+    WaylandTabletSeat *seat = nullptr;
+    zwp_tablet_tool_v2 *proxy = nullptr;
+
+    InputDeviceTabletTool::Type type = InputDeviceTabletTool::Pen;
+    quint64 serialId = 0;
+    quint64 uniqueId = 0;
+    QList<InputDeviceTabletTool::Capability> capabilities;
+    bool done = false;
+    WaylandTabletTool *kwinTool = nullptr;
+
+    WaylandTabletToolFrame frame;
+    zwp_tablet_v2 *enteredTablet = nullptr;
+    wl_surface *enteredSurface = nullptr;
+    quint32 enterSerial = 0;
+
+    QPointF surfacePosition;
+    qreal pressure = 0;
+    qreal distance = 0;
+    QPointF tilt;
+    qreal rotation = 0;
+    qreal slider = 0;
+
+    WaylandTabletDevice *device = nullptr;
+    KWayland::Client::Surface *surface = nullptr;
+    QPointF position;
+    QPointF outputTilt;
+    qreal outputRotation = 0;
+    bool tipDown = false;
+    QList<quint32> pressedButtons;
+    std::chrono::milliseconds lastTime{0};
+};
+
+WaylandTabletSeat::WaylandTabletSeat(zwp_tablet_manager_v2 *manager, wl_seat *nativeSeat, WaylandSeat *seat)
+    : m_seat(seat)
+{
+    static const zwp_tablet_seat_v2_listener listener{
+        .tablet_added = handleTabletAdded,
+        .tool_added = handleToolAdded,
+        .pad_added = handlePadAdded,
+    };
+    m_tabletSeat = zwp_tablet_manager_v2_get_tablet_seat(manager, nativeSeat);
+    zwp_tablet_seat_v2_add_listener(m_tabletSeat, &listener, this);
+}
+
+WaylandTabletSeat::~WaylandTabletSeat()
+{
+    for (const auto &device : m_devices) {
+        if (device->m_done) {
+            Q_EMIT deviceRemoved(device.get());
+        }
+    }
+    for (const auto &tool : m_tools) {
+        zwp_tablet_tool_v2_destroy(tool->proxy);
+    }
+    m_tools.clear();
+    m_devices.clear();
+    zwp_tablet_seat_v2_destroy(m_tabletSeat);
+}
+
+QList<InputDevice *> WaylandTabletSeat::devices() const
+{
+    QList<InputDevice *> devices;
+    for (const auto &device : m_devices) {
+        if (device->m_done) {
+            devices.append(device.get());
+        }
+    }
+    return devices;
+}
+
+bool WaylandTabletSeat::hasToolInProximity() const
+{
+    return std::ranges::any_of(m_tools, [](const auto &tool) {
+        return tool->device != nullptr;
+    });
+}
+
+void WaylandTabletSeat::handleTabletAdded(void *data, zwp_tablet_seat_v2 *seat, zwp_tablet_v2 *tablet)
+{
+    auto tabletSeat = static_cast<WaylandTabletSeat *>(data);
+    tabletSeat->m_devices.push_back(std::make_unique<WaylandTabletDevice>(tablet, ++tabletSeat->m_lastDeviceId, tabletSeat));
+}
+
+void WaylandTabletSeat::handlePadAdded(void *data, zwp_tablet_seat_v2 *seat, zwp_tablet_pad_v2 *pad)
+{
+    zwp_tablet_pad_v2_destroy(pad);
+}
+
+void WaylandTabletSeat::handleToolAdded(void *data, zwp_tablet_seat_v2 *seat, zwp_tablet_tool_v2 *proxy)
+{
+    static const zwp_tablet_tool_v2_listener listener{
+        .type = [](void *data, zwp_tablet_tool_v2 *, uint32_t type) {
+            static_cast<Tool *>(data)->type = toolType(type);
+        },
+        .hardware_serial = [](void *data, zwp_tablet_tool_v2 *, uint32_t hi, uint32_t lo) {
+            static_cast<Tool *>(data)->serialId = (quint64(hi) << 32) | lo;
+        },
+        .hardware_id_wacom = [](void *data, zwp_tablet_tool_v2 *, uint32_t hi, uint32_t lo) {
+            static_cast<Tool *>(data)->uniqueId = (quint64(hi) << 32) | lo;
+        },
+        .capability = [](void *data, zwp_tablet_tool_v2 *, uint32_t capability) {
+            auto tool = static_cast<Tool *>(data);
+            if (const auto value = toolCapability(capability); value && !tool->capabilities.contains(*value)) {
+                tool->capabilities.append(*value);
+            }
+        },
+        .done = [](void *data, zwp_tablet_tool_v2 *) {
+            static_cast<Tool *>(data)->done = true;
+        },
+        .removed = [](void *data, zwp_tablet_tool_v2 *) {
+            auto tool = static_cast<Tool *>(data);
+            tool->seat->toolRemoved(tool);
+        },
+        .proximity_in = [](void *data, zwp_tablet_tool_v2 *, uint32_t serial, zwp_tablet_v2 *tablet, wl_surface *surface) {
+            auto tool = static_cast<Tool *>(data);
+            tool->frame.proximity = WaylandTabletToolFrame::Proximity::In;
+            tool->enteredTablet = tablet;
+            tool->enteredSurface = surface;
+            tool->enterSerial = serial;
+        },
+        .proximity_out = [](void *data, zwp_tablet_tool_v2 *) {
+            static_cast<Tool *>(data)->frame.proximity = WaylandTabletToolFrame::Proximity::Out;
+        },
+        .down = [](void *data, zwp_tablet_tool_v2 *, uint32_t) {
+            static_cast<Tool *>(data)->frame.down = true;
+        },
+        .up = [](void *data, zwp_tablet_tool_v2 *) {
+            static_cast<Tool *>(data)->frame.up = true;
+        },
+        .motion = [](void *data, zwp_tablet_tool_v2 *, wl_fixed_t x, wl_fixed_t y) {
+            auto tool = static_cast<Tool *>(data);
+            tool->surfacePosition = QPointF(wl_fixed_to_double(x), wl_fixed_to_double(y));
+            tool->frame.axesChanged = true;
+        },
+        .pressure = [](void *data, zwp_tablet_tool_v2 *, uint32_t pressure) {
+            auto tool = static_cast<Tool *>(data);
+            tool->pressure = std::clamp(pressure / 65535.0, 0.0, 1.0);
+            tool->frame.axesChanged = true;
+        },
+        .distance = [](void *data, zwp_tablet_tool_v2 *, uint32_t distance) {
+            auto tool = static_cast<Tool *>(data);
+            tool->distance = std::clamp(distance / 65535.0, 0.0, 1.0);
+            tool->frame.axesChanged = true;
+        },
+        .tilt = [](void *data, zwp_tablet_tool_v2 *, wl_fixed_t x, wl_fixed_t y) {
+            auto tool = static_cast<Tool *>(data);
+            tool->tilt = QPointF(wl_fixed_to_double(x), wl_fixed_to_double(y));
+            tool->frame.axesChanged = true;
+        },
+        .rotation = [](void *data, zwp_tablet_tool_v2 *, wl_fixed_t degrees) {
+            auto tool = static_cast<Tool *>(data);
+            tool->rotation = wl_fixed_to_double(degrees);
+            tool->frame.axesChanged = true;
+        },
+        .slider = [](void *data, zwp_tablet_tool_v2 *, int32_t position) {
+            auto tool = static_cast<Tool *>(data);
+            tool->slider = std::clamp(position / 65535.0, -1.0, 1.0);
+            tool->frame.axesChanged = true;
+        },
+        .wheel = [](void *, zwp_tablet_tool_v2 *, wl_fixed_t, int32_t) {
+        },
+        .button = [](void *data, zwp_tablet_tool_v2 *, uint32_t, uint32_t button, uint32_t state) {
+            static_cast<Tool *>(data)->frame.buttons.emplace_back(button, state == ZWP_TABLET_TOOL_V2_BUTTON_STATE_PRESSED);
+        },
+        .frame = [](void *data, zwp_tablet_tool_v2 *, uint32_t time) {
+            auto tool = static_cast<Tool *>(data);
+            tool->seat->toolFrame(tool, time);
+        },
+    };
+
+    auto tabletSeat = static_cast<WaylandTabletSeat *>(data);
+    auto tool = std::make_unique<Tool>();
+    tool->seat = tabletSeat;
+    tool->proxy = proxy;
+    zwp_tablet_tool_v2_add_listener(proxy, &listener, tool.get());
+    tabletSeat->m_tools.push_back(std::move(tool));
+}
+
+WaylandTabletDevice *WaylandTabletSeat::findDevice(zwp_tablet_v2 *tablet) const
+{
+    const auto it = std::ranges::find_if(m_devices, [tablet](const auto &device) {
+        return device->m_tablet == tablet;
+    });
+    return it == m_devices.end() ? nullptr : it->get();
+}
+
+void WaylandTabletSeat::tabletDone(WaylandTabletDevice *device)
+{
+    if (!device->m_done) {
+        device->m_done = true;
+        Q_EMIT deviceAdded(device);
+    }
+}
+
+void WaylandTabletSeat::tabletRemoved(WaylandTabletDevice *device)
+{
+    for (const auto &tool : m_tools) {
+        if (tool->device == device) {
+            leaveProximity(tool.get(), tool->lastTime);
+        }
+    }
+    const auto it = std::ranges::find_if(m_devices, [device](const auto &candidate) {
+        return candidate.get() == device;
+    });
+    std::unique_ptr<WaylandTabletDevice> removed = std::move(*it);
+    m_devices.erase(it);
+    if (removed->m_done) {
+        Q_EMIT deviceRemoved(removed.get());
+    }
+    removed.release()->deleteLater();
+}
+
+void WaylandTabletSeat::toolRemoved(Tool *tool)
+{
+    leaveProximity(tool, tool->lastTime);
+    zwp_tablet_tool_v2_destroy(tool->proxy);
+    std::erase_if(m_tools, [tool](const auto &candidate) {
+        return candidate.get() == tool;
+    });
+}
+
+WaylandTabletTool *WaylandTabletSeat::findOrCreateTool(const Tool *tool, const WaylandTabletDevice *device)
+{
+    // tablet-v2 ties a tool without a hardware serial to its tablet.
+    const quint64 owner = tool->serialId ? 0 : device->m_id;
+    const auto it = std::ranges::find_if(m_kwinTools, [tool, owner](const KWinTool &candidate) {
+        return candidate.owner == owner
+            && candidate.tool->type() == tool->type
+            && candidate.tool->serialId() == tool->serialId
+            && candidate.tool->uniqueId() == tool->uniqueId
+            && candidate.tool->capabilities() == tool->capabilities;
+    });
+    if (it != m_kwinTools.end()) {
+        return it->tool;
+    }
+    auto kwinTool = new WaylandTabletTool(tool->type, tool->serialId, tool->uniqueId, tool->capabilities, this);
+    m_kwinTools.push_back(KWinTool{owner, kwinTool});
+    return kwinTool;
+}
+
+bool WaylandTabletSeat::updateValues(Tool *tool)
+{
+    WaylandBackend *backend = m_seat->backend();
+    WaylandOutput *output = backend->findOutput(tool->surface);
+    if (!output) {
+        return false;
+    }
+    const KWayland::Client::SubSurface *subsurface = backend->findSubSurface(tool->surface);
+    const QPointF position = output->mapToOutput(tool->surfacePosition + (subsurface ? subsurface->position() : QPoint()));
+    const QSizeF size = output->transform().map(QSizeF(std::round(output->modeSize().width() / output->scale()),
+                                                       std::round(output->modeSize().height() / output->scale())));
+    const QPointF origin = output->position();
+    tool->position = QPointF(std::clamp(position.x(), origin.x(), origin.x() + std::max(0.0, size.width() - 1)),
+                             std::clamp(position.y(), origin.y(), origin.y() + std::max(0.0, size.height() - 1)));
+    tool->outputTilt = tabletTiltToOutput(output->transform(), tool->tilt);
+    tool->outputRotation = tabletRotationToOutput(output->transform(), tool->rotation);
+    return true;
+}
+
+void WaylandTabletSeat::scheduleRepaints()
+{
+    const auto outputs = m_seat->backend()->waylandOutputs();
+    for (WaylandOutput *output : outputs) {
+        output->renderLoop()->scheduleRepaint();
+    }
+}
+
+void WaylandTabletSeat::toolFrame(Tool *tool, uint32_t time)
+{
+    const WaylandTabletToolFrame frame = std::exchange(tool->frame, WaylandTabletToolFrame{});
+    zwp_tablet_v2 *const enteredTablet = std::exchange(tool->enteredTablet, nullptr);
+    wl_surface *const enteredSurface = std::exchange(tool->enteredSurface, nullptr);
+    const quint32 enterSerial = std::exchange(tool->enterSerial, 0);
+    const std::chrono::milliseconds timestamp(time);
+    tool->lastTime = timestamp;
+    if (!tool->done) {
+        return;
+    }
+
+    WaylandTabletDevice *enteredDevice = nullptr;
+    if (frame.proximity == WaylandTabletToolFrame::Proximity::In) {
+        enteredDevice = findDevice(enteredTablet);
+        KWayland::Client::Surface *surface = KWayland::Client::Surface::get(enteredSurface);
+        if (!enteredDevice || !enteredDevice->m_done || !surface || !m_seat->backend()->findOutput(surface)) {
+            qCDebug(KWIN_WAYLAND_BACKEND) << "Ignoring a tablet tool on an unknown tablet or surface";
+            leaveProximity(tool, timestamp);
+            return;
+        }
+        if (tool->device != enteredDevice) {
+            leaveProximity(tool, timestamp);
+        }
+        zwp_tablet_tool_v2_set_cursor(tool->proxy, enterSerial, nullptr, 0, 0);
+        tool->surface = surface;
+        if (!tool->kwinTool) {
+            tool->kwinTool = findOrCreateTool(tool, enteredDevice);
+        }
+    }
+
+    const WaylandTabletToolActions actions = planTabletToolFrame(frame, tool->device != nullptr, tool->tipDown, tool->pressedButtons);
+    if (actions.proximityIn) {
+        tool->device = enteredDevice;
+        scheduleRepaints();
+    }
+    WaylandTabletDevice *device = tool->device;
+    if (!device) {
+        return;
+    }
+    if ((frame.axesChanged || actions.proximityIn) && !updateValues(tool)) {
+        leaveProximity(tool, timestamp);
+        return;
+    }
+
+    if (actions.proximityIn) {
+        Q_EMIT device->tabletToolProximityEvent(tool->position, tool->outputTilt.x(), tool->outputTilt.y(), tool->outputRotation, tool->distance, true, tool->slider, tool->kwinTool, timestamp, device);
+    }
+    if (actions.tipDown) {
+        tool->tipDown = true;
+        Q_EMIT device->tabletToolTipEvent(tool->position, tool->pressure, tool->outputTilt.x(), tool->outputTilt.y(), tool->outputRotation, tool->distance, true, tool->slider, tool->kwinTool, timestamp, device);
+    }
+    if (actions.tipUp) {
+        tool->tipDown = false;
+        Q_EMIT device->tabletToolTipEvent(tool->position, tool->pressure, tool->outputTilt.x(), tool->outputTilt.y(), tool->outputRotation, tool->distance, false, tool->slider, tool->kwinTool, timestamp, device);
+    }
+    if (actions.axis) {
+        Q_EMIT device->tabletToolAxisEvent(tool->position, tool->pressure, tool->outputTilt.x(), tool->outputTilt.y(), tool->outputRotation, tool->distance, tool->tipDown, tool->slider, tool->kwinTool, timestamp, device);
+    }
+    for (const auto &[button, pressed] : actions.buttons) {
+        if (pressed) {
+            tool->pressedButtons.append(button);
+        } else {
+            tool->pressedButtons.removeOne(button);
+        }
+        Q_EMIT device->tabletToolButtonEvent(button, pressed, tool->kwinTool, timestamp, device);
+    }
+    if (actions.proximityOut) {
+        leaveProximity(tool, timestamp);
+    }
+}
+
+void WaylandTabletSeat::leaveProximity(Tool *tool, std::chrono::microseconds time)
+{
+    WaylandTabletDevice *device = tool->device;
+    if (!device) {
+        return;
+    }
+    if (tool->tipDown) {
+        tool->tipDown = false;
+        Q_EMIT device->tabletToolTipEvent(tool->position, tool->pressure, tool->outputTilt.x(), tool->outputTilt.y(), tool->outputRotation, tool->distance, false, tool->slider, tool->kwinTool, time, device);
+    }
+    for (quint32 button : std::exchange(tool->pressedButtons, {})) {
+        Q_EMIT device->tabletToolButtonEvent(button, false, tool->kwinTool, time, device);
+    }
+    // KWin 6.6 takes the position of a proximity out as the tool's position.
+    Q_EMIT device->tabletToolProximityEvent(tool->position, tool->outputTilt.x(), tool->outputTilt.y(), tool->outputRotation, tool->distance, false, tool->slider, tool->kwinTool, time, device);
+    tool->device = nullptr;
+    tool->surface = nullptr;
+    scheduleRepaints();
+}
