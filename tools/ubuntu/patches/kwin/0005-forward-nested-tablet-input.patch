+WaylandTabletDevice::WaylandTabletDevice(zwp_tablet_v2 *tablet, quint64 id, WaylandTabletSeat *seat)
+    : m_tablet(tablet)
+    , m_id(id)
+    , m_seat(seat)
+    // KWin sends the bus type to its clients, and a version 1 host never sends one.
+    , m_busType(BUS_VIRTUAL)
+{
+    static const zwp_tablet_v2_listener listener{
+        .name = [](void *data, zwp_tablet_v2 *, const char *name) {
+            static_cast<WaylandTabletDevice *>(data)->m_name = QString::fromUtf8(name);
+        },
+        .id = [](void *data, zwp_tablet_v2 *, uint32_t vendor, uint32_t product) {
+            auto device = static_cast<WaylandTabletDevice *>(data);
+            device->m_vendor = vendor;
+            device->m_product = product;
+        },
+        .path = [](void *data, zwp_tablet_v2 *, const char *path) {
+            static_cast<WaylandTabletDevice *>(data)->m_path = QString::fromUtf8(path);
+        },
+        .done = [](void *data, zwp_tablet_v2 *) {
+            auto device = static_cast<WaylandTabletDevice *>(data);
+            device->m_seat->tabletDone(device);
+        },
+        .removed = [](void *data, zwp_tablet_v2 *) {
+            auto device = static_cast<WaylandTabletDevice *>(data);
+            device->m_seat->tabletRemoved(device);
+        },
+        .bustype = [](void *data, zwp_tablet_v2 *, uint32_t bustype) {
+            static_cast<WaylandTabletDevice *>(data)->m_busType = bustype;
+        },
+    };
+    zwp_tablet_v2_add_listener(m_tablet, &listener, this);
+}
+
+WaylandTabletDevice::~WaylandTabletDevice()
+{
+    zwp_tablet_v2_destroy(m_tablet);
+}
